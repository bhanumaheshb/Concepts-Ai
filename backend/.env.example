# --- master switch: true => zero network calls, no API keys needed anywhere ---
MOCK_MODE=true

# --- providers (all mockable) ---
LLM_PROVIDER=mock            # mock | mock_synthesis | lmstudio | cloudflare
EMBEDDING_PROVIDER=mock      # mock | none
IMAGE_PROVIDER=none          # none  (future: gemini | imagen | flux | openai)

# --- engine ---
ENGINE_SEED=42
ONTOLOGY_VERSION=v1
DEFAULT_K=10

# --- mock behaviour knobs (exercise retry + repair paths in tests) ---
MOCK_LLM_FAILURE_RATE=0.0
MOCK_CRITIC_POLICY=deterministic_only   # all_pass | deterministic_only | fail_rate:0.2

# --- creative synthesis: local model (LLM_PROVIDER=lmstudio) ---
# LM Studio: load a model, then Developer > Start Server. Also serves llama.cpp
# and vLLM -- only the port changes.
LLM_BASE_URL=http://localhost:1234
LLM_MODEL=                   # blank => ask the server which model is loaded
LLM_API_KEY=                 # local servers ignore this

# --- creative synthesis: hosted (LLM_PROVIDER=cloudflare) ---
# The token needs the "Workers AI" permission.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=                    # blank => @cf/meta/llama-3.3-70b-instruct-fp8-fast

# --- creative synthesis: shared ---
# Leaving a provider unconfigured does NOT disable synthesis: the stage runs and
# fails per concept, rather than passing deterministic prose off as model output.
LLM_TIMEOUT=300              # a local model on CPU can legitimately take minutes
LLM_MAX_OUTPUT_TOKENS=8192
SYNTHESIS_REPAIRS=1
CREATIVE_SYNTHESIS=          # optional explicit on/off override

# --- serving ---
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# NOTE: no image-generation API key is required. The engine never calls one.
